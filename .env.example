# ==========================================
# SoleCraft Footwear Commerce Environment Configuration Example
# ==========================================

# Supabase PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret for Session Cookies
JWT_SECRET=your_super_secret_jwt_key_here

# App and Authentication Settings
VITE_APP_ID=solecraft-footwear
OAUTH_SERVER_URL=http://localhost:3000
OWNER_OPEN_ID=admin_solecraft

# Server Settings
PORT=3000
NODE_ENV=development

# Stripe Payment Provider (Free Test Mode)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
